<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="640" prefWidth="1000.0" style="-fx-background-color: beige; -fx-border-color: black; -fx-border-width: 2px;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.BookingPageController">
   <children>
      <HBox alignment="CENTER" prefHeight="142.0" prefWidth="1007.0">
         <children>
            <Label fx:id="restaurantLabel" alignment="CENTER" prefHeight="55.0" prefWidth="348.0" text="Welcome to x Restaurant" textAlignment="CENTER">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <VBox alignment="CENTER" layoutX="-1.0" layoutY="89.0" prefHeight="391.0" prefWidth="1007.0">
         <children>
            <Label alignment="TOP_CENTER" contentDisplay="TOP" text="Make a reservation">
               <font>
                  <Font size="24.0" />
               </font>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <cursor>
                  <Cursor fx:constant="NONE" />
               </cursor>
            </Label>
            <HBox alignment="CENTER" prefHeight="62.0" prefWidth="748.0">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Contact information">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Text>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="54.0" prefWidth="414.0" spacing="20.0" style="-fx-background-color: beige;">
               <children>
                  <TextField fx:id="name" prefHeight="26.0" prefWidth="175.0" promptText="First Name" />
                  <TextField fx:id="surname" prefHeight="26.0" prefWidth="175.0" promptText="Last Name" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="61.0" prefWidth="414.0" spacing="20.0">
               <children>
                  <DatePicker fx:id="date" onAction="#pickDateToBook" prefHeight="32.0" prefWidth="208.0" promptText="dd/mm/yyyy" showWeekNumbers="true">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </DatePicker>
                  <ChoiceBox fx:id="timeSlotsPicker" prefHeight="26.0" prefWidth="203.0" />
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </HBox>
            <Button fx:id="bookButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#bookTable" prefHeight="26.0" prefWidth="192.0" text="Confirm Booking" textAlignment="CENTER">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </Button>
         </children>
      </VBox>
      <HBox alignment="CENTER" layoutX="-2.0" layoutY="469.0" prefHeight="100.0" prefWidth="1007.0" spacing="100.0">
         <children>
            <Button mnemonicParsing="false" onAction="#resetBookingInfo" text="Reset" />
            <Button fx:id="closeButton" alignment="CENTER" mnemonicParsing="false" onAction="#returnToMainPage" text="Close" />
         </children>
      </HBox>
   </children>
</AnchorPane>
